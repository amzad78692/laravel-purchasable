{
    "name": "amzad/laravel-purchasable",
    "description": "Simple, single-item purchase handling for Laravel Eloquent models (event bookings, subscription plans, and similar) - no cart, no line items.",
    "keywords": [
        "amzad",
        "laravel",
        "laravel-purchasable",
        "purchase",
        "orders",
        "payments"
    ],
    "homepage": "https://github.com/amzad78692/laravel-purchasable",
    "support": {
        "issues": "https://github.com/amzad78692/laravel-purchasable/issues",
        "source": "https://github.com/amzad78692/laravel-purchasable/tree/main"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "amzad78692",
            "email": "amzad.nnt@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0||^11.0||^12.0",
        "spatie/laravel-model-states": "^2.12",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "carlos-meneses/laravel-mpdf": "^2.1",
        "filament/filament": "^5.10",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^8.0||^9.0||^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "suggest": {
        "filament/filament": "Required to use the optional Filament v4 admin panel resources for Orders and Transactions (Amzad\\LaravelPurchasable\\Filament\\PurchasablePlugin).",
        "carlos-meneses/laravel-mpdf": "Required to use the \"Print invoice\" action on the Filament Order resource."
    },
    "autoload": {
        "psr-4": {
            "Amzad\\LaravelPurchasable\\": "src/",
            "Amzad\\LaravelPurchasable\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amzad\\LaravelPurchasable\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Amzad\\LaravelPurchasable\\LaravelPurchasableServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
